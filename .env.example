# Copy to .env. Node reads it natively with `node --env-file=.env`, so there is
# no python-dotenv equivalent to install. Every variable here is parsed and
# checked by the Zod schema in packages/schemas/src/env.ts at startup.

NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# Any OpenAI-compatible endpoint. Examples:
#   OpenAI    https://api.openai.com/v1
#   vLLM      http://localhost:8000/v1
#   Ollama    http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-replace-me
AGENT_MODEL=gpt-5.6-luna

# Leave unset to run without a database; storage becomes a no-op.
DATABASE_URL=postgres://agent:agent@localhost:5432/agent

# Leave unset to keep tracing off.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
